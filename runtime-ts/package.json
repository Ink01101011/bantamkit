{
  "name": "bantamkit-mcp",
  "version": "0.36.2",
  "description": "Persistent memory for coding agents: an MCP server for Claude Code, Claude Desktop, Cursor and VS Code Copilot. Layered project memory, Claude Code hooks, JSON Schema validation, token ledger and shift-work tools. Pure Node; install once with npx, run offline.",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "claude-code",
    "claude-desktop",
    "cursor",
    "copilot",
    "github-copilot",
    "vscode",
    "agent",
    "ai-agents",
    "memory",
    "agent-memory",
    "persistent-memory",
    "claude-code-hooks",
    "json-schema",
    "token-usage",
    "llm"
  ],
  "homepage": "https://github.com/Ink01101011/bantamkit#readme",
  "bugs": {
    "url": "https://github.com/Ink01101011/bantamkit/issues"
  },
  "type": "module",
  "bin": {
    "bantamkit-mcp": "dist/cli.js",
    "bantamkit-memory": "dist/memory/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "assets"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "sync-assets": "node scripts/sync-assets.mjs",
    "prepack": "node scripts/build-for-pack.mjs && npm run sync-assets",
    "prepublishOnly": "node scripts/gate-before-publish.mjs",
    "pretest": "npm run build",
    "test": "node scripts/run-tests.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ink01101011/bantamkit.git",
    "directory": "runtime-ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0"
  }
}
